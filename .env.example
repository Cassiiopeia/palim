# Palim 환경변수 예시
# 실제 값을 채운 뒤 .env 로 복사한다. .env 는 커밋 대상이 아니다.

# --- 실행 프로파일 (dev | prod) ---
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=palim
DB_USER=palim
DB_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=palim
RABBITMQ_PASSWORD=

# --- 채널 API 인증정보 암호화 마스터키 (설계서 6.2) ---
# 채널 API 키는 DB에 AES-GCM 으로 암호화되어 저장되며, 이 키로만 복호화된다.
# 분실 시 등록된 모든 채널 인증정보를 재등록해야 한다.
# 값이 없으면 애플리케이션이 기동되지 않는다 (암호화 없이 뜨지 않게 하기 위함).
#
#   생성: openssl rand -base64 32
#
PALIM_CRYPTO_MASTER_KEY=

# --- Telegram ---
# 봇 토큰은 BotFather 에서 발급한다. 없으면 알림이 Outbox 에 쌓이기만 하고 유실되지는 않는다.
# 수신 대상(chat_id)은 환경변수가 아니라 웹 관리자에서 등록한다 — 발주자가 직접 바꿀 수 있어야 한다.
TELEGRAM_BOT_TOKEN=

# --- 관리자 계정 (설계서 F-09, 단일 계정) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
