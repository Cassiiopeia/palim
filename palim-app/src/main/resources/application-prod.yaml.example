# 운영 설정 템플릿.
#
# 실제 application-prod.yaml 은 gitignore 대상이다 — 이 저장소는 PUBLIC 이다.
# 배포 시 이 파일을 복사해 application-prod.yaml 을 만들고, 값은 환경변수로 주입한다
# (GitHub Actions 에서는 Secrets → env). 여기에는 플레이스홀더 외 실제 값을 절대 쓰지 않는다.
#
# 필요한 환경변수: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD,
#                  PALIM_CRYPTO_MASTER_KEY, TELEGRAM_BOT_TOKEN
#
# ADMIN_USERNAME · ADMIN_PASSWORD 는 선택이다 (#51).
#   - 지정하면 그 값으로 관리자 계정을 만든다.
#   - 비우면 admin/admin 으로 만들되 최초 로그인에서 비밀번호 변경을 강제한다.
#     변경 전까지 다른 화면은 사용할 수 없으므로, 지정하지 않아도 안전하게 기동한다.
#   - 이미 계정이 있으면 어느 쪽이든 덮어쓰지 않는다.

spring:
  datasource:
    url: jdbc:postgresql://${DB_HOST}:${DB_PORT:5432}/${DB_NAME}
    username: ${DB_USER}
    password: ${DB_PASSWORD}

server:
  # Cloudflare Tunnel 이 HTTPS 를 종단하고 X-Forwarded-* 를 붙인다. 이 설정이 있어야 감사
  # 로그의 IP 가 프록시 주소가 아닌 실제 클라이언트 IP 로 남는다 (07-DECISIONS 020).
  # 프록시 없이 직접 노출하는 환경에서는 켜면 안 된다 — 클라이언트가 IP 를 위조할 수 있다.
  forward-headers-strategy: framework

logging:
  level:
    kr.suhsaechan.palim: INFO
