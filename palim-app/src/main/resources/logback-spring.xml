<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그 설정. Spring Boot 기본 구성에 비밀값 마스킹(%msg 대신 %maskedMsg)만 얹는다 (09-SECURITY).

  base.xml 을 include 하면 appender 가 %msg 로 고정되어 마스킹을 끼울 수 없으므로,
  defaults 만 가져와 콘솔 appender 를 직접 정의한다. 파일 로그는 컨테이너 런타임(docker logs)이
  담당하므로 콘솔만 있으면 된다(06-OPERATIONS).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <conversionRule conversionWord="maskedMsg"
                    class="kr.suhsaechan.palim.logging.SecretMaskingConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}){faint} %clr(%5p) %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %maskedMsg%n%wEx</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
